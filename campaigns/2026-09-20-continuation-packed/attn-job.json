{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "name": "kai-batch0918-full-e1000-0920",
    "namespace": "cms-ml",
    "labels": {
      "app": "kai-batch0918-screen",
      "campaign": "batch20260918",
      "continuation": "full1000-20260920"
    }
  },
  "spec": {
    "completionMode": "Indexed",
    "completions": 15,
    "parallelism": 15,
    "backoffLimitPerIndex": 6,
    "podReplacementPolicy": "Failed",
    "activeDeadlineSeconds": 1209600,
    "ttlSecondsAfterFinished": 604800,
    "podFailurePolicy": {
      "rules": [
        {
          "action": "Ignore",
          "onPodConditions": [
            {
              "type": "DisruptionTarget"
            }
          ]
        }
      ]
    },
    "template": {
      "metadata": {
        "labels": {
          "app": "kai-batch0918-screen",
          "campaign": "batch20260918",
          "continuation": "full1000-20260920"
        }
      },
      "spec": {
        "affinity": {
          "nodeAffinity": {
            "preferredDuringSchedulingIgnoredDuringExecution": [
              {
                "weight": 100,
                "preference": {
                  "matchExpressions": [
                    {
                      "key": "nvidia.com/gpu.product",
                      "operator": "In",
                      "values": [
                        "NVIDIA-GeForce-RTX-4090",
                        "NVIDIA-L40S",
                        "NVIDIA-L40",
                        "NVIDIA-A10",
                        "NVIDIA-GeForce-RTX-3090"
                      ]
                    }
                  ]
                }
              }
            ],
            "requiredDuringSchedulingIgnoredDuringExecution": {
              "nodeSelectorTerms": [
                {
                  "matchExpressions": [
                    {
                      "key": "nvidia.com/gpu.product",
                      "operator": "In",
                      "values": [
                        "NVIDIA-GeForce-RTX-4090",
                        "NVIDIA-L40S",
                        "NVIDIA-L40",
                        "NVIDIA-A10",
                        "NVIDIA-GeForce-RTX-3090",
                        "NVIDIA-L4",
                        "NVIDIA-RTX-A5000",
                        "NVIDIA-RTX-A4000",
                        "NVIDIA-GeForce-RTX-2080-Ti",
                        "Tesla-V100-SXM2-32GB",
                        "Tesla-V100-SXM2-16GB",
                        "Tesla-V100-PCIE-16GB",
                        "NVIDIA-TITAN-RTX",
                        "Quadro-RTX-6000",
                        "NVIDIA-RTX-5000-Ada-Generation",
                        "NVIDIA-RTX-4000-Ada-Generation"
                      ]
                    },
                    {
                      "key": "kubernetes.io/hostname",
                      "operator": "NotIn",
                      "values": [
                        "nautilus-ext-gpu01.fullerton.edu",
                        "ren-gp-argo-01.madren.org"
                      ]
                    }
                  ]
                }
              ]
            }
          }
        },
        "automountServiceAccountToken": false,
        "containers": [
          {
            "args": [
              "set -euo pipefail\nexport KERAS_BACKEND=tensorflow MPLBACKEND=Agg TF_FORCE_GPU_ALLOW_GROWTH=true\nexport OMP_NUM_THREADS=4 TF_NUM_INTRAOP_THREADS=4 TF_NUM_INTEROP_THREADS=2 OPENBLAS_NUM_THREADS=1\nmkdir -p /work/code\necho '774a2d4d18c3b2f92f61349af8d38711bc2e9bcc3fd6428b8ba056be5d55b2a6  /cmcode/hgq2.tar.gz' | sha256sum -c -\ntar -xzf /cmcode/hgq2.tar.gz -C /work/code --strip-components=1\nexport PYTHONPATH=/work/code BNHGQ2_CODE_SHA256=774a2d4d18c3b2f92f61349af8d38711bc2e9bcc3fd6428b8ba056be5d55b2a6\nexport WANDB_ENTITY=kayamaguchi-uc-san-diego WANDB_PROJECT=BNJetTag-Batch20260917\nexport WANDB_GROUP=batch20260918 WANDB_MODE=online WANDB_TAGS=batch20260918,attention-precision-schedule,l1x3\nexport WANDB_DIR=/work WANDB_CACHE_DIR=/work/wandb-cache WANDB_DATA_DIR=/work/wandb-data\npip install -q --no-cache-dir -r /work/code/requirements-training.txt\nNVLIBS=$(python -c \"import glob; print(':'.join(sorted(glob.glob('/usr/local/lib/python*/site-packages/nvidia/*/lib'))))\")\nexport LD_LIBRARY_PATH=\"$NVLIBS${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}\"\nnvidia-smi --query-gpu=name,memory.total --format=csv,noheader\npython -c \"import tensorflow as tf; assert tf.config.list_physical_devices('GPU'); print('[gpu] GPU gate PASS')\"\npython -c \"import wandb; assert wandb.Api().viewer; print('[wandb] authentication PASS')\"\ncat > /work/continue_full.py <<'PYCONTINUE'\nimport json, os, pathlib, subprocess, sys\ncode=pathlib.Path('/work/code')\ncampaign='batch20260918'\ni=int(os.environ['JOB_COMPLETION_INDEX'])\nif campaign=='batch20260917':\n    assert 0<=i<12\n    name=f'batch20260917-a{i:02d}-s1'\nelse:\n    runs=json.loads((code/'configs'/campaign/'index.json').read_text())['runs']\n    assert [r['index'] for r in runs]==list(range(len(runs)))\n    name=runs[i]['name']\nconfig=code/'configs'/campaign/(name+'.json')\ncfg=json.loads(config.read_text()); assert cfg['train']['epochs']==1000\nroot=pathlib.Path('/data/batch20260917')/('n'+str(cfg['arch']['n_part']))\nprint('[continuation] '+name+' full configured1000 epochs',flush=True)\nsubprocess.run([sys.executable,'-u',str(code/'run_ablation.py'),'train','--config',str(config),'--root',str(root),'--track'],check=True)\nPYCONTINUE\ntimeout --signal=TERM --kill-after=180s 255600s python -u /work/continue_full.py\n"
            ],
            "command": [
              "bash",
              "-c"
            ],
            "env": [
              {
                "name": "WANDB_API_KEY",
                "valueFrom": {
                  "secretKeyRef": {
                    "key": "WANDB_API_KEY",
                    "name": "kai-wandb"
                  }
                }
              }
            ],
            "image": "python:3.12",
            "imagePullPolicy": "IfNotPresent",
            "name": "train",
            "resources": {
              "limits": {
                "cpu": "4",
                "ephemeral-storage": "24Gi",
                "memory": "12Gi",
                "nvidia.com/gpu": "1"
              },
              "requests": {
                "cpu": "4",
                "ephemeral-storage": "24Gi",
                "memory": "12Gi",
                "nvidia.com/gpu": "1"
              }
            },
            "terminationMessagePath": "/dev/termination-log",
            "terminationMessagePolicy": "File",
            "volumeMounts": [
              {
                "mountPath": "/cmcode",
                "name": "code",
                "readOnly": true
              },
              {
                "mountPath": "/work",
                "name": "work"
              },
              {
                "mountPath": "/data",
                "name": "persistent"
              }
            ]
          }
        ],
        "dnsPolicy": "ClusterFirst",
        "nodeSelector": {
          "kubernetes.io/arch": "amd64"
        },
        "restartPolicy": "Never",
        "schedulerName": "default-scheduler",
        "securityContext": {},
        "terminationGracePeriodSeconds": 180,
        "volumes": [
          {
            "name": "code",
            "configMap": {
              "name": "kai-batch0918-code-774a2d4d18",
              "defaultMode": 420
            }
          },
          {
            "emptyDir": {
              "sizeLimit": "24Gi"
            },
            "name": "work"
          },
          {
            "name": "persistent",
            "persistentVolumeClaim": {
              "claimName": "kai-data"
            }
          }
        ]
      }
    }
  }
}
