{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "name": "kai-engram-full-e1000-0920-p4",
    "namespace": "cms-ml",
    "labels": {
      "app": "kai-engram-screen",
      "campaign": "engram-study-20260918",
      "continuation": "full1000-20260920-packed"
    }
  },
  "spec": {
    "completionMode": "Indexed",
    "completions": 1,
    "parallelism": 1,
    "backoffLimitPerIndex": 6,
    "podReplacementPolicy": "Failed",
    "activeDeadlineSeconds": 1209600,
    "ttlSecondsAfterFinished": 604800,
    "podFailurePolicy": {
      "rules": [
        {
          "action": "Ignore",
          "onPodConditions": [
            {
              "type": "DisruptionTarget"
            }
          ]
        }
      ]
    },
    "template": {
      "metadata": {
        "labels": {
          "app": "kai-engram-screen",
          "campaign": "engram-study-20260918",
          "continuation": "full1000-20260920-packed"
        }
      },
      "spec": {
        "affinity": {
          "nodeAffinity": {
            "preferredDuringSchedulingIgnoredDuringExecution": [
              {
                "weight": 100,
                "preference": {
                  "matchExpressions": [
                    {
                      "key": "nvidia.com/gpu.product",
                      "operator": "In",
                      "values": [
                        "NVIDIA-GeForce-RTX-4090",
                        "NVIDIA-L40S",
                        "NVIDIA-L40",
                        "NVIDIA-A10",
                        "NVIDIA-GeForce-RTX-3090"
                      ]
                    }
                  ]
                }
              }
            ],
            "requiredDuringSchedulingIgnoredDuringExecution": {
              "nodeSelectorTerms": [
                {
                  "matchExpressions": [
                    {
                      "key": "nvidia.com/gpu.product",
                      "operator": "In",
                      "values": [
                        "NVIDIA-GeForce-RTX-4090",
                        "NVIDIA-L40S",
                        "NVIDIA-L40",
                        "NVIDIA-A10",
                        "NVIDIA-GeForce-RTX-3090",
                        "NVIDIA-L4",
                        "NVIDIA-RTX-A5000",
                        "NVIDIA-RTX-A4000",
                        "NVIDIA-GeForce-RTX-2080-Ti",
                        "Tesla-V100-SXM2-32GB",
                        "Tesla-V100-SXM2-16GB",
                        "Tesla-V100-PCIE-16GB",
                        "NVIDIA-TITAN-RTX",
                        "Quadro-RTX-6000",
                        "NVIDIA-RTX-5000-Ada-Generation",
                        "NVIDIA-RTX-4000-Ada-Generation"
                      ]
                    },
                    {
                      "key": "kubernetes.io/hostname",
                      "operator": "NotIn",
                      "values": [
                        "k8s-chase-ci-07.calit2.optiputer.net",
                        "nautilus-ext-gpu01.fullerton.edu",
                        "ren-gp-argo-01.madren.org"
                      ]
                    }
                  ]
                }
              ]
            }
          }
        },
        "automountServiceAccountToken": false,
        "containers": [
          {
            "args": [
              "set -euo pipefail\nexport KERAS_BACKEND=tensorflow MPLBACKEND=Agg TF_FORCE_GPU_ALLOW_GROWTH=true\nexport OMP_NUM_THREADS=2 TF_NUM_INTRAOP_THREADS=2 TF_NUM_INTEROP_THREADS=1 OPENBLAS_NUM_THREADS=1\nmkdir -p /work/code\necho 'a10364eda9f4e5b8fbdfe1b4eadbae7b60006362bc9f493cafb056e74dedc792  /cmcode/hgq2.tar.gz' | sha256sum -c -\ntar -xzf /cmcode/hgq2.tar.gz -C /work/code --strip-components=1\nexport PYTHONPATH=/work/code BNHGQ2_CODE_SHA256=a10364eda9f4e5b8fbdfe1b4eadbae7b60006362bc9f493cafb056e74dedc792\n\nexport WANDB_ENTITY=kayamaguchi-uc-san-diego WANDB_PROJECT=BNJetTag-Engram-Experimental\nexport WANDB_GROUP=engram-screen WANDB_MODE=online WANDB_TAGS=engram,pilot,l1x3,n16,validation-only\nexport WANDB_DIR=/work WANDB_CACHE_DIR=/work/wandb-cache WANDB_DATA_DIR=/work/wandb-data\nexport WANDB_DISABLE_CODE=true WANDB_QUIET=true\npip install -q --no-cache-dir -r /work/code/requirements-training.txt\nNVLIBS=$(python -c \"import glob; print(':'.join(sorted(glob.glob('/usr/local/lib/python*/site-packages/nvidia/*/lib'))))\")\nexport LD_LIBRARY_PATH=\"$NVLIBS${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}\"\npython /work/code/ops/private_project.py\nnvidia-smi --query-gpu=name,memory.total --format=csv,noheader\npython -c \"import tensorflow as tf; assert tf.config.list_physical_devices('GPU'); print('GPU_GATE_PASS')\"\narm_name() { printf \"engram-e%02d-s1\" \"$1\"; }\nPACKS=(\"2 1 3 0\")\npids=()\ntrap 'kill -TERM \"${pids[@]}\" 2>/dev/null || true' TERM INT\nfor a in ${PACKS[$JOB_COMPLETION_INDEX]}; do\n  timeout --signal=TERM --kill-after=180s 255600s python -u /work/code/run_engram.py train --config /work/code/configs/engram/$(arm_name $a).json --data-cache /data/batch20260917/n16/data --out /data/engram-study-20260918/runs/$(arm_name $a) --track > >(sed -u \"s/^/[arm$a] /\") 2>&1 &\n  pids+=($!)\ndone\nrc=0\nfor p in \"${pids[@]}\"; do wait \"$p\" || rc=1; done\nwait\nexit $rc\n"
            ],
            "command": [
              "bash",
              "-c"
            ],
            "env": [
              {
                "name": "WANDB_API_KEY",
                "valueFrom": {
                  "secretKeyRef": {
                    "key": "WANDB_API_KEY",
                    "name": "kai-wandb"
                  }
                }
              }
            ],
            "image": "python:3.12",
            "imagePullPolicy": "IfNotPresent",
            "name": "train",
            "resources": {
              "limits": {
                "cpu": "8",
                "ephemeral-storage": "24Gi",
                "memory": "24Gi",
                "nvidia.com/gpu": "1"
              },
              "requests": {
                "cpu": "8",
                "ephemeral-storage": "24Gi",
                "memory": "24Gi",
                "nvidia.com/gpu": "1"
              }
            },
            "terminationMessagePath": "/dev/termination-log",
            "terminationMessagePolicy": "File",
            "volumeMounts": [
              {
                "mountPath": "/cmcode",
                "name": "code",
                "readOnly": true
              },
              {
                "mountPath": "/work",
                "name": "work"
              },
              {
                "mountPath": "/data",
                "name": "persistent"
              }
            ]
          }
        ],
        "dnsPolicy": "ClusterFirst",
        "nodeSelector": {
          "kubernetes.io/arch": "amd64"
        },
        "restartPolicy": "Never",
        "schedulerName": "default-scheduler",
        "securityContext": {},
        "terminationGracePeriodSeconds": 180,
        "volumes": [
          {
            "name": "code",
            "configMap": {
              "name": "kai-engram-code-a10364eda9",
              "defaultMode": 420
            }
          },
          {
            "emptyDir": {
              "sizeLimit": "24Gi"
            },
            "name": "work"
          },
          {
            "name": "persistent",
            "persistentVolumeClaim": {
              "claimName": "kai-data"
            }
          }
        ]
      }
    }
  }
}
