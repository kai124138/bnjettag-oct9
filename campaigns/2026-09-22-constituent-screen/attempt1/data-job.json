{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "name": "kai-n8n64-data-0922",
    "namespace": "cms-ml",
    "labels": {
      "app": "kai-n8n64-data",
      "user": "kai",
      "campaign": "constituent-study-20260922"
    }
  },
  "spec": {
    "ttlSecondsAfterFinished": 604800,
    "template": {
      "metadata": {
        "labels": {
          "app": "kai-n8n64-data",
          "user": "kai",
          "campaign": "constituent-study-20260922"
        }
      },
      "spec": {
        "affinity": {
          "nodeAffinity": {
            "requiredDuringSchedulingIgnoredDuringExecution": {
              "nodeSelectorTerms": [
                {
                  "matchExpressions": [
                    {
                      "key": "kubernetes.io/hostname",
                      "operator": "NotIn",
                      "values": [
                        "nautilus-ext-gpu01.fullerton.edu",
                        "k8s-chase-ci-07.calit2.optiputer.net",
                        "ren-gp-argo-01.madren.org"
                      ]
                    }
                  ]
                }
              ]
            },
            "preferredDuringSchedulingIgnoredDuringExecution": [
              {
                "weight": 100,
                "preference": {
                  "matchExpressions": [
                    {
                      "key": "kubernetes.io/hostname",
                      "operator": "In",
                      "values": [
                        "gpn-fiona-mizzou-8.rnet.missouri.edu"
                      ]
                    }
                  ]
                }
              }
            ]
          }
        },
        "automountServiceAccountToken": false,
        "containers": [
          {
            "args": [
              "set -euo pipefail\nexport KERAS_BACKEND=tensorflow CUDA_VISIBLE_DEVICES=-1 WANDB_MODE=disabled TF_CPP_MIN_LOG_LEVEL=2\nexport OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=1 TF_NUM_INTRAOP_THREADS=2 TF_NUM_INTEROP_THREADS=1\nmkdir -p /work/code\necho '994002b3a3b171bfa225d6ceb80344181c8d8b45c34b026ae0ac0e3cda25941e  /cmcode/hgq2.tar.gz' | sha256sum -c -\ntar -xzf /cmcode/hgq2.tar.gz -C /work/code --strip-components=1\nexport PYTHONPATH=/work/code BNHGQ2_CODE_SHA256=994002b3a3b171bfa225d6ceb80344181c8d8b45c34b026ae0ac0e3cda25941e\npip install -q --no-cache-dir -r /work/code/requirements-cpu.txt\npython -u /work/code/prepare_cache.py --configs /work/code/cache_configs --root /data/constituent-study-20260922 --raw /data/hls4ml_lhc_jet/train/train --n-parts 8,64\n"
            ],
            "command": [
              "bash",
              "-c"
            ],
            "image": "python:3.12",
            "imagePullPolicy": "IfNotPresent",
            "name": "prepare",
            "resources": {
              "requests": {
                "cpu": "4",
                "memory": "16Gi",
                "ephemeral-storage": "12Gi"
              },
              "limits": {
                "cpu": "4",
                "memory": "16Gi",
                "ephemeral-storage": "12Gi"
              }
            },
            "terminationMessagePath": "/dev/termination-log",
            "terminationMessagePolicy": "File",
            "volumeMounts": [
              {
                "mountPath": "/cmcode",
                "name": "code",
                "readOnly": true
              },
              {
                "mountPath": "/work",
                "name": "work"
              },
              {
                "mountPath": "/data",
                "name": "persistent"
              }
            ]
          }
        ],
        "dnsPolicy": "ClusterFirst",
        "nodeSelector": {
          "kubernetes.io/arch": "amd64"
        },
        "restartPolicy": "Never",
        "schedulerName": "default-scheduler",
        "securityContext": {},
        "terminationGracePeriodSeconds": 180,
        "volumes": [
          {
            "name": "code",
            "configMap": {
              "name": "kai-n8n64-data-994002b3a3",
              "defaultMode": 420
            }
          },
          {
            "emptyDir": {
              "sizeLimit": "24Gi"
            },
            "name": "work"
          },
          {
            "name": "persistent",
            "persistentVolumeClaim": {
              "claimName": "kai-data"
            }
          }
        ]
      }
    },
    "backoffLimit": 0,
    "activeDeadlineSeconds": 7200
  }
}
