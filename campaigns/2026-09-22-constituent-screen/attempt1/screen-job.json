{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "name": "kai-n8n64-screen-0922-a2c434",
    "namespace": "cms-ml",
    "labels": {
      "user": "kai",
      "campaign": "constituent-study-20260922",
      "app": "kai-n8n64-screen"
    }
  },
  "spec": {
    "completionMode": "Indexed",
    "completions": 16,
    "parallelism": 16,
    "backoffLimitPerIndex": 2,
    "podReplacementPolicy": "Failed",
    "activeDeadlineSeconds": 28800,
    "ttlSecondsAfterFinished": 604800,
    "podFailurePolicy": {
      "rules": [
        {
          "action": "Ignore",
          "onPodConditions": [
            {
              "type": "DisruptionTarget"
            }
          ]
        }
      ]
    },
    "template": {
      "metadata": {
        "labels": {
          "user": "kai",
          "campaign": "constituent-study-20260922",
          "app": "kai-n8n64-screen"
        }
      },
      "spec": {
        "affinity": {
          "nodeAffinity": {
            "preferredDuringSchedulingIgnoredDuringExecution": [
              {
                "weight": 100,
                "preference": {
                  "matchExpressions": [
                    {
                      "key": "nvidia.com/gpu.product",
                      "operator": "In",
                      "values": [
                        "NVIDIA-GeForce-RTX-4090",
                        "NVIDIA-L40S",
                        "NVIDIA-L40",
                        "NVIDIA-A10",
                        "NVIDIA-GeForce-RTX-3090"
                      ]
                    }
                  ]
                }
              }
            ],
            "requiredDuringSchedulingIgnoredDuringExecution": {
              "nodeSelectorTerms": [
                {
                  "matchExpressions": [
                    {
                      "key": "nvidia.com/gpu.product",
                      "operator": "In",
                      "values": [
                        "NVIDIA-GeForce-RTX-4090",
                        "NVIDIA-L40S",
                        "NVIDIA-L40",
                        "NVIDIA-A10",
                        "NVIDIA-GeForce-RTX-3090",
                        "NVIDIA-L4",
                        "NVIDIA-RTX-A5000",
                        "NVIDIA-RTX-A4000",
                        "NVIDIA-GeForce-RTX-2080-Ti",
                        "Tesla-V100-SXM2-32GB",
                        "Tesla-V100-SXM2-16GB",
                        "Tesla-V100-PCIE-16GB",
                        "NVIDIA-TITAN-RTX",
                        "Quadro-RTX-6000",
                        "NVIDIA-RTX-5000-Ada-Generation",
                        "NVIDIA-RTX-4000-Ada-Generation"
                      ]
                    },
                    {
                      "key": "kubernetes.io/hostname",
                      "operator": "NotIn",
                      "values": [
                        "k8s-chase-ci-07.calit2.optiputer.net",
                        "nautilus-ext-gpu01.fullerton.edu",
                        "ren-gp-argo-01.madren.org"
                      ]
                    }
                  ]
                }
              ]
            }
          }
        },
        "automountServiceAccountToken": false,
        "containers": [
          {
            "args": [
              "set -euo pipefail\nexport KERAS_BACKEND=tensorflow MPLBACKEND=Agg TF_FORCE_GPU_ALLOW_GROWTH=true TF_CPP_MIN_LOG_LEVEL=2\nexport OMP_NUM_THREADS=2 TF_NUM_INTRAOP_THREADS=2 TF_NUM_INTEROP_THREADS=1 OPENBLAS_NUM_THREADS=1\nmkdir -p /work/code\necho 'a2c434d19c1fec62e23864d996efdcc6edb797bf001fecebeacaef4344293296  /cmcode/hgq2.tar.gz' | sha256sum -c -\ntar -xzf /cmcode/hgq2.tar.gz -C /work/code --strip-components=1\nexport PYTHONPATH=/work/code BNHGQ2_CODE_SHA256=a2c434d19c1fec62e23864d996efdcc6edb797bf001fecebeacaef4344293296\nexport WANDB_ENTITY=kayamaguchi-uc-san-diego WANDB_PROJECT=BNJetTag-Engram-Experimental\nexport WANDB_GROUP=constituent-20260922-fast50 WANDB_MODE=online WANDB_TAGS=constituents,fast50,matched,validation-only\nexport WANDB_DIR=/work WANDB_CACHE_DIR=/work/wandb-cache WANDB_DATA_DIR=/work/wandb-data WANDB_DISABLE_CODE=true WANDB_QUIET=true\npip install -q --no-cache-dir -r /work/code/requirements-training.txt\nNVLIBS=$(python -c \"import glob; print(':'.join(sorted(glob.glob('/usr/local/lib/python*/site-packages/nvidia/*/lib'))))\")\nexport LD_LIBRARY_PATH=\"$NVLIBS${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}\"\npython -c \"import tensorflow as tf; assert tf.config.list_physical_devices('GPU'); print('GPU_GATE_PASS')\"\npython -u /work/code/run_pack.py packs.json\n"
            ],
            "command": [
              "bash",
              "-c"
            ],
            "env": [
              {
                "name": "WANDB_API_KEY",
                "valueFrom": {
                  "secretKeyRef": {
                    "key": "WANDB_API_KEY",
                    "name": "kai-wandb"
                  }
                }
              }
            ],
            "image": "python:3.12",
            "imagePullPolicy": "IfNotPresent",
            "name": "train",
            "resources": {
              "limits": {
                "cpu": "6",
                "ephemeral-storage": "24Gi",
                "memory": "18Gi",
                "nvidia.com/gpu": "1"
              },
              "requests": {
                "cpu": "6",
                "ephemeral-storage": "24Gi",
                "memory": "18Gi",
                "nvidia.com/gpu": "1"
              }
            },
            "terminationMessagePath": "/dev/termination-log",
            "terminationMessagePolicy": "File",
            "volumeMounts": [
              {
                "mountPath": "/cmcode",
                "name": "code",
                "readOnly": true
              },
              {
                "mountPath": "/work",
                "name": "work"
              },
              {
                "mountPath": "/data",
                "name": "persistent"
              }
            ]
          }
        ],
        "dnsPolicy": "ClusterFirst",
        "nodeSelector": {
          "kubernetes.io/arch": "amd64"
        },
        "restartPolicy": "Never",
        "schedulerName": "default-scheduler",
        "securityContext": {},
        "terminationGracePeriodSeconds": 180,
        "volumes": [
          {
            "name": "code",
            "configMap": {
              "name": "kai-n8n64-code-a2c434d19c",
              "defaultMode": 420
            }
          },
          {
            "emptyDir": {
              "sizeLimit": "24Gi"
            },
            "name": "work"
          },
          {
            "name": "persistent",
            "persistentVolumeClaim": {
              "claimName": "kai-data"
            }
          }
        ]
      }
    }
  }
}
