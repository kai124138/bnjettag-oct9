{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "name": "kai-n8n64-preflight-0922-26f3cc",
    "namespace": "cms-ml",
    "labels": {
      "user": "kai",
      "campaign": "constituent-study-20260922",
      "app": "kai-n8n64-preflight"
    }
  },
  "spec": {
    "completionMode": "Indexed",
    "completions": 2,
    "parallelism": 2,
    "backoffLimitPerIndex": 2,
    "podReplacementPolicy": "Failed",
    "activeDeadlineSeconds": 28800,
    "ttlSecondsAfterFinished": 604800,
    "podFailurePolicy": {
      "rules": [
        {
          "action": "Ignore",
          "onPodConditions": [
            {
              "type": "DisruptionTarget"
            }
          ]
        }
      ]
    },
    "template": {
      "metadata": {
        "labels": {
          "user": "kai",
          "campaign": "constituent-study-20260922",
          "app": "kai-n8n64-preflight"
        }
      },
      "spec": {
        "affinity": {
          "nodeAffinity": {
            "requiredDuringSchedulingIgnoredDuringExecution": {
              "nodeSelectorTerms": [
                {
                  "matchExpressions": [
                    {
                      "key": "kubernetes.io/hostname",
                      "operator": "NotIn",
                      "values": [
                        "k8s-chase-ci-07.calit2.optiputer.net",
                        "nautilus-ext-gpu01.fullerton.edu",
                        "ren-gp-argo-01.madren.org"
                      ]
                    }
                  ]
                }
              ]
            }
          }
        },
        "automountServiceAccountToken": false,
        "containers": [
          {
            "args": [
              "set -euo pipefail\nexport KERAS_BACKEND=tensorflow MPLBACKEND=Agg TF_FORCE_GPU_ALLOW_GROWTH=true TF_CPP_MIN_LOG_LEVEL=2\nexport NVIDIA_TF32_OVERRIDE=0\nexport OMP_NUM_THREADS=2 TF_NUM_INTRAOP_THREADS=2 TF_NUM_INTEROP_THREADS=1 OPENBLAS_NUM_THREADS=1\nmkdir -p /work/code\necho '26f3cc40a8f7c9ff378760c5b0d8ce046508cb4de585f9c4b80ea93653515a45  /cmcode/hgq2.tar.gz' | sha256sum -c -\ntar -xzf /cmcode/hgq2.tar.gz -C /work/code --strip-components=1\nexport PYTHONPATH=/work/code BNHGQ2_CODE_SHA256=26f3cc40a8f7c9ff378760c5b0d8ce046508cb4de585f9c4b80ea93653515a45\nexport CUDA_VISIBLE_DEVICES=-1 WANDB_MODE=disabled\npip install -q --no-cache-dir -r /work/code/requirements-cpu.txt\npython -u /work/code/run_study.py preflight --index \"$JOB_COMPLETION_INDEX\" --shards 2\n"
            ],
            "command": [
              "bash",
              "-c"
            ],
            "image": "python:3.12",
            "imagePullPolicy": "IfNotPresent",
            "name": "train",
            "resources": {
              "limits": {
                "cpu": "4",
                "ephemeral-storage": "12Gi",
                "memory": "16Gi"
              },
              "requests": {
                "cpu": "4",
                "ephemeral-storage": "12Gi",
                "memory": "16Gi"
              }
            },
            "terminationMessagePath": "/dev/termination-log",
            "terminationMessagePolicy": "File",
            "volumeMounts": [
              {
                "mountPath": "/cmcode",
                "name": "code",
                "readOnly": true
              },
              {
                "mountPath": "/work",
                "name": "work"
              },
              {
                "mountPath": "/data",
                "name": "persistent"
              }
            ]
          }
        ],
        "dnsPolicy": "ClusterFirst",
        "nodeSelector": {
          "kubernetes.io/arch": "amd64"
        },
        "restartPolicy": "Never",
        "schedulerName": "default-scheduler",
        "securityContext": {},
        "terminationGracePeriodSeconds": 180,
        "volumes": [
          {
            "name": "code",
            "configMap": {
              "name": "kai-n8n64-code-26f3cc40a8",
              "defaultMode": 420
            }
          },
          {
            "emptyDir": {
              "sizeLimit": "24Gi"
            },
            "name": "work"
          },
          {
            "name": "persistent",
            "persistentVolumeClaim": {
              "claimName": "kai-data"
            }
          }
        ]
      }
    }
  }
}
