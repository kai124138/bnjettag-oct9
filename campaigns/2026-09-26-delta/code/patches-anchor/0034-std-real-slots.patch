diff --git a/code/bnhgq2/data.py b/code/bnhgq2/data.py
index a64b08e..260cc1e 100644
--- a/code/bnhgq2/data.py
+++ b/code/bnhgq2/data.py
@@ -116,5 +116,22 @@ def input_std_stats(X, eps=1e-6):
     return mu.astype("float32"), sigma.astype("float32")
 
 
+def real_slot_mask(X, features):
+    """Delta (std-real-slots): True on real constituents. Padded and pT-gated slots are all-zero
+    rows in raw space (apply_pt_gate zeroes every feature), so a slot is real iff its RAW pT != 0.
+    Call before standardization."""
+    return X[..., list(features).index('pt')] != 0
+
+
+def input_std_stats_real_slots(X, features, eps=1e-6):
+    """Delta (std-real-slots): per-feature z-score stats over real slots only (train split).
+    Gated / padded slots then standardize to -mu/sigma of the real slots."""
+    real = X[real_slot_mask(X, features)]
+    mu = real.mean(axis=0)
+    sigma = real.std(axis=0)
+    sigma = np.where(sigma < eps, 1.0, sigma)
+    return mu.astype("float32"), sigma.astype("float32")
+
+
 def apply_input_std(X, mu, sigma):
     return ((X - np.asarray(mu, dtype="float32")) / np.asarray(sigma, dtype="float32")).astype("float32")
diff --git a/code/bnhgq2/delta_keys.py b/code/bnhgq2/delta_keys.py
index e047275..082aea7 100644
--- a/code/bnhgq2/delta_keys.py
+++ b/code/bnhgq2/delta_keys.py
@@ -649,3 +649,17 @@ def _linformer_k(value, cfg):
 
 register('arch.attn_kind', 'attn-linformer / attn-relu-over-n', _attn_kind)
 register('arch.linformer_k', 'attn-linformer', _linformer_k)
+
+# std-real-slots (anchor tree only; M041, M079, M080): data.std_scope "real_slots" computes the
+# train-split standardization over real slots only (raw pT != 0: padded and pT-gated slots are
+# all-zero rows), in prepare_cache; the scope is part of the cache identity (data_info std_scope,
+# checked by run_engram.load_cache and prepare_cache.verify), so it needs its own cache.
+UNWIRED.pop('data.std_scope', None)
+
+
+def _std_scope(value, cfg):
+    if value != 'real_slots':
+        return 'only "real_slots" is implemented (all slots is the default when absent)'
+
+
+register('data.std_scope', 'std-real-slots', _std_scope, export_ok=True)
