+        ROOT = Path(env.get('BNJ_RUN_ROOT', str(ROOT)))
+        print('PACK_ROOTS', json.dumps(env, sort_keys=True), flush=True)
     stop_after = sys.argv[2] if len(sys.argv) > 2 else None
