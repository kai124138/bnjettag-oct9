diff --git a/code/tests/test_run_pack_delta.py b/code/tests/test_run_pack_delta.py
new file mode 100644
index 0000000..c7acc9c
--- /dev/null
+++ b/code/tests/test_run_pack_delta.py
@@ -0,0 +1,93 @@
+"""[Delta 0038] run_pack.py with run names and dict-form packs files (fake arms, no TF):
+names resolve to index rows, run_root / data_root reach the children and the runner's own
+logs, a pack_meta data_root wins over the file-level one, bad names and env conflicts are
+refused before any arm starts, and the legacy list of row numbers is unchanged."""
+import json
+import os
+import shutil
+import subprocess
+import sys
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parents[1]
+
+FAKE = r'''
+import sys, os, json
+from pathlib import Path
+idx = int(sys.argv[sys.argv.index('--index') + 1])
+root = Path(os.environ.get('BNJ_RUN_ROOT', '/nonexistent-default-root'))
+name = json.loads((Path(__file__).parent / 'index.json').read_text())['runs'][idx]['name']
+run = root / 'runs' / name; run.mkdir(parents=True, exist_ok=True)
+(run / 'seen.json').write_text(json.dumps({'index': idx, 'data_root': os.environ.get('BNJ_DATA_ROOT')}))
+print('child', idx, name, flush=True)
+'''
+
+ROWS = [{'name': 'a'}, {'name': None, 'file': None}, {'name': 'b'}, {'name': 'c'}]
+
+
+def setup(tmp, packs, **extra_env):
+    shutil.copy(HERE / 'run_pack.py', tmp / 'run_pack.py')
+    (tmp / 'run_study.py').write_text(FAKE)
+    (tmp / 'index.json').write_text(json.dumps({'runs': ROWS}))
+    (tmp / 'packs.json').write_text(json.dumps(packs))
+    fake_bin = tmp / 'bin'                        # the laptop has no nvidia-smi; the tarball runner calls it
+    fake_bin.mkdir(exist_ok=True)
+    (fake_bin / 'nvidia-smi').write_text('#!/bin/sh\necho fake-gpu\n')
+    (fake_bin / 'nvidia-smi').chmod(0o755)
+    env = {k: v for k, v in os.environ.items() if not k.startswith('BNJ_')}
+    env['PATH'] = f"{fake_bin}{os.pathsep}{env.get('PATH', '')}"
+    env.update(JOB_COMPLETION_INDEX='0', BNJ_STAGGER_SECONDS='0', BNJ_RETRY_DELAY_SECONDS='0',
+               BNJ_POLL_SECONDS='0.2', **extra_env)
+    return env
+
+
+def run(tmp, env):
+    return subprocess.run([sys.executable, str(tmp / 'run_pack.py'), 'packs.json'], env=env, cwd=tmp,
+                          capture_output=True, text=True, timeout=120)
+
+
+def seen(root, name):
+    return json.loads((root / 'runs' / name / 'seen.json').read_text())
+
+
+def test_names_and_roots(tmp_path):
+    root, data = tmp_path / 'delta-root', '/data/chang-n64-20260926'
+    env = setup(tmp_path, {'packs': [['c', 'a'], ['b']], 'run_root': str(root), 'data_root': data})
+    r = run(tmp_path, env)
+    assert r.returncode == 0, r.stdout + r.stderr
+    assert 'ARM_STARTED 3 c' in r.stdout and 'ARM_STARTED 0 a' in r.stdout
+    assert seen(root, 'c') == {'index': 3, 'data_root': data}
+    assert (root / 'logs').is_dir() and any(p.name.startswith('c-') for p in (root / 'logs').iterdir())
+
+
+def test_pack_meta_data_root_wins(tmp_path):
+    root = tmp_path / 'r'
+    packs = {'packs': [['b']], 'run_root': str(root), 'data_root': '/data/anchor',
+             'pack_meta': [{'data_root': '/data/delta-20260927/caches/abcd1234'}]}
+    r = run(tmp_path, setup(tmp_path, packs))
+    assert r.returncode == 0, r.stdout + r.stderr
+    assert seen(root, 'b')['data_root'] == '/data/delta-20260927/caches/abcd1234'
+
+
+def test_unknown_name_refused_before_start(tmp_path):
+    r = run(tmp_path, setup(tmp_path, {'packs': [['a', 'zzz']], 'run_root': str(tmp_path / 'r')}))
+    assert r.returncode == 2 and 'PACK_NAME_NOT_IN_INDEX zzz' in r.stdout and 'ARM_STARTED' not in r.stdout
+
+
+def test_env_conflict_refused(tmp_path):
+    env = setup(tmp_path, {'packs': [['a']], 'run_root': str(tmp_path / 'r')}, BNJ_RUN_ROOT=str(tmp_path / 'other'))
+    r = run(tmp_path, env)
+    assert r.returncode == 2 and 'PACKS_ENV_CONFLICT BNJ_RUN_ROOT' in r.stdout and 'ARM_STARTED' not in r.stdout
+
+
+def test_legacy_list_unchanged(tmp_path):
+    root = tmp_path / 'legacy'
+    r = run(tmp_path, setup(tmp_path, [[0, 2]], BNJ_RUN_ROOT=str(root)))
+    assert r.returncode == 0, r.stdout + r.stderr
+    assert 'PACK_ROOTS' not in r.stdout
+    assert seen(root, 'a') == {'index': 0, 'data_root': None} and seen(root, 'b')['index'] == 2
+
+
+def test_dict_without_run_root_refused(tmp_path):
+    r = run(tmp_path, setup(tmp_path, {'packs': [['a']], 'data_root': '/data/x'}))
+    assert r.returncode == 2 and 'PACKS_RUN_ROOT_MISSING' in r.stdout and 'ARM_STARTED' not in r.stdout
