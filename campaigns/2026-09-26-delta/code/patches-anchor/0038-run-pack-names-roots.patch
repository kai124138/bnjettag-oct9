 """
 import json
 import os
@@ -47,7 +50,52 @@ CGROUP = Path(os.environ.get('BNJ_CGROUP_DIR', '/sys/fs/cgroup'))
 PROC = Path(os.environ.get('BNJ_PROC_DIR', '/proc'))
 EXIT_DIVERGED = 3
 EXIT_MEMORY_GATE = 5
+EXIT_BAD_PACK = 2
 children = []
+CHILD_ENV = {}   # [Delta 0038] roots from a dict-form packs file, exported to every child
+
+
+def resolve_pack(spec, rows, completion_index):
+    """[Delta 0038] (row indices, env) for this pod's pack.
+
+    spec is either the legacy list of packs (each a list of index.json row numbers) or a dict
+    {"packs": [...], "run_root": str, "data_root": str, "pack_meta": [{"data_root": str}, ...]}.
+    A pack entry is a row number (unchanged) or a run name, resolved against the unique `name`
+    of index.json rows. run_root / data_root (a pack_meta value wins over the file-level one)
+    become BNJ_RUN_ROOT / BNJ_DATA_ROOT for the children (run_study reads both at import) and
+    this runner's own ROOT; an environment value that disagrees is refused, never overridden.
+    """
+    if isinstance(spec, dict):
+        packs = spec['packs']
+        meta = (spec.get('pack_meta') or [{}] * len(packs))[completion_index]
+        if not spec.get('run_root'):     # runner and children must agree on runs/ and logs/
+            print('PACKS_RUN_ROOT_MISSING', flush=True)
+            raise SystemExit(EXIT_BAD_PACK)
+    else:
+        packs, meta, spec = spec, {}, {}
+    env = {}
+    for key, var in (('run_root', 'BNJ_RUN_ROOT'), ('data_root', 'BNJ_DATA_ROOT')):
+        value = meta.get(key, spec.get(key))
+        if value is None:
+            continue
+        if os.environ.get(var) not in (None, str(value)):
+            print('PACKS_ENV_CONFLICT', var, os.environ[var], 'packs file', value, flush=True)
+            raise SystemExit(EXIT_BAD_PACK)
+        env[var] = str(value)
+    names = [r.get('name') for r in rows]
+    by_name = {n: i for i, n in enumerate(names) if n}
+    indices = []
+    for item in packs[completion_index]:
+        if isinstance(item, str):
+            if names.count(item) != 1:
+                print('PACK_NAME_NOT_UNIQUE_IN_INDEX' if item in by_name else 'PACK_NAME_NOT_IN_INDEX', item, flush=True)
+                raise SystemExit(EXIT_BAD_PACK)
+            item = by_name[item]
+        elif isinstance(item, bool) or not isinstance(item, int):
+            print('PACK_ENTRY_INVALID', repr(item), flush=True)
+            raise SystemExit(EXIT_BAD_PACK)
+        indices.append(item)
+    return indices, env
 
 
 def stop(signum, frame):
@@ -75,7 +123,8 @@ def launch(index, name, stop_after, attempt):
     path = log / f'{name}-{os.environ.get("HOSTNAME", "pod")}.log'
     handle = path.open('a', buffering=1)
     handle.write(f'==== ARM_ATTEMPT {attempt} {time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}\n')
-    child = subprocess.Popen(command, stdout=handle, stderr=subprocess.STDOUT, start_new_session=True)
+    child = subprocess.Popen(command, stdout=handle, stderr=subprocess.STDOUT, start_new_session=True,
+                             env={**os.environ, **CHILD_ENV} if CHILD_ENV else None)
     print('ARM_STARTED', index, name, 'pid', child.pid, 'attempt', attempt, flush=True)
     return {'child': child, 'index': index, 'name': name, 'handle': handle, 'log': path,
             'started': time.monotonic(), 'started_wall': time.time(), 'attempt': attempt,
@@ -174,9 +223,14 @@ def terminate(entries):
 def main():
     signal.signal(signal.SIGTERM, stop)
     signal.signal(signal.SIGINT, stop)
+    global ROOT
