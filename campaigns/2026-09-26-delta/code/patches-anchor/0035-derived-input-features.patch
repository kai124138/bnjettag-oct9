     return mu.astype("float32"), sigma.astype("float32")
 
 
+DERIVED_FEATURES = ('log_pt', 'delta_r')
+
+
+def derive_features(X, features, derived):
+    """Delta (derived-input-features): append columns computed from the RAW L1 features, after
+    the pT gate and before standardization, in the order given: "log_pt" = ln(pT / GeV) on real
+    slots and 0 on padded / gated slots (raw pT == 0, where the log is undefined; rule, recorded
+    in DELTA code/README.md); "delta_r" = sqrt(etarel^2 + phirel^2) (0 on zeroed slots). Both
+    are invariant under the eta/phi reflections of augment-eta-phi-reflect."""
+    features = list(features)
+    cols = []
+    for name in derived:
+        if name == 'log_pt':
+            pt = X[..., features.index('pt')].astype('float64')
+            cols.append(np.where(pt > 0, np.log(np.where(pt > 0, pt, 1.0)), 0.0))
+        elif name == 'delta_r':
+            eta = X[..., features.index('etarel')].astype('float64')
+            phi = X[..., features.index('phirel')].astype('float64')
+            cols.append(np.sqrt(eta * eta + phi * phi))
+        else:
+            raise ValueError(f'unknown derived feature {name!r}; known {DERIVED_FEATURES}')
+    if not cols:
+        return X
+    return np.concatenate([X, np.stack(cols, axis=-1).astype(X.dtype)], axis=-1)
+
+
 def real_slot_mask(X, features):
     """Delta (std-real-slots): True on real constituents. Padded and pT-gated slots are all-zero
     rows in raw space (apply_pt_gate zeroes every feature), so a slot is real iff its RAW pT != 0.
diff --git a/code/bnhgq2/delta_keys.py b/code/bnhgq2/delta_keys.py
index 082aea7..ee9544c 100644
--- a/code/bnhgq2/delta_keys.py
+++ b/code/bnhgq2/delta_keys.py
@@ -663,3 +663,25 @@ def _std_scope(value, cfg):
 
 
 register('data.std_scope', 'std-real-slots', _std_scope, export_ok=True)
+
+# derived-input-features (anchor tree only; M040, M067, M080, M081, M085-M087, M091-M093, M095):
+# arch.derived_features ["log_pt", "delta_r"] appends columns computed from the raw L1 features
+# after the pT gate and before standardization (data.derive_features, in prepare_cache and in
+# data.load_eval_set for ROC-test), and arch.n_feat = 3 + len(derived_features). log pT is 0 on
+# padded / gated slots (rule). The derived list is part of the cache identity.
+UNWIRED.pop('arch.derived_features', None)
+
+
+def _derived(value, cfg):
+    known = ('log_pt', 'delta_r')
+    if not isinstance(value, list) or not value or len(set(value)) != len(value) or set(value) - set(known):
+        return f'must be a non-empty list of distinct names from {list(known)}'
+    if lookup(cfg, 'arch.n_feat') != 3 + len(value):
+        return 'arch.n_feat must be 3 + len(arch.derived_features)'
+    if lookup(cfg, 'arch.pair_bias'):
+        return 'not combined with arch.pair_bias (PairFeatures de-standardizes exactly 3 features)'
+    if lookup(cfg, 'engram_study.module') is not None:
+        return 'the Engram tokenizer reads the 3 L1 features'
+
+
+register('arch.derived_features', 'derived-input-features', _derived)
