Subject: [PATCH 33/38] attn-linformer: wire newmods/linformer.py
 (arch.attn_kind linformer, arch.linformer_k) into the qat block loop and
 expected_binary_layers; export refused (M004, M053)

---
 code/bnhgq2/ablation.py   |  3 +++
 code/bnhgq2/delta_keys.py | 33 +++++++++++++++++++++++++++++++++
 code/bnhgq2/qat.py        | 28 +++++++++++++++++++---------
 3 files changed, 55 insertions(+), 9 deletions(-)

diff --git a/code/bnhgq2/ablation.py b/code/bnhgq2/ablation.py
index d358d20..93911b7 100644
--- a/code/bnhgq2/ablation.py
+++ b/code/bnhgq2/ablation.py
@@ -632,6 +632,9 @@ def projection_layers(cfg):
                      ('attn_Wq', 'attn_Wk', 'attn_Wv', 'attn_Wo', 'ffn_fc1', 'ffn_fc2'))
     if cfg['arch'].get('pair_bias', False):
         names.update(('pair_fc1', 'pair_fc2'))
+    if cfg['arch'].get('attn_kind') == 'linformer':  # Delta (attn-linformer): E, F sequence projections
+        from newmods.linformer import linformer_binary_layers
+        names.update(linformer_binary_layers(cfg))
     return names
 
 
diff --git a/code/bnhgq2/delta_keys.py b/code/bnhgq2/delta_keys.py
index ff4335a..e047275 100644
--- a/code/bnhgq2/delta_keys.py
+++ b/code/bnhgq2/delta_keys.py
@@ -616,3 +616,36 @@ def _pre_shift(value, cfg):
 
 
 register('quant.pre_quant_shift', 'pre-quant-shift', _pre_shift)
+
+# attn-linformer (anchor tree only; wiring of newmods/linformer.py, new-files engineer; M004,
+# M053, M054, M056, M060): arch.attn_kind "linformer" replaces scores / softmax / A.V of every
+# block with binary sequence projections E, F (N -> arch.linformer_k) on K and V, built with the
+# block's own closures (so [A20] WRAP / Chang softmax apply unchanged); expected_binary_layers
+# adds bit_block_<i>_attn_{Elin,Flin}. No HLS path (hgq2 0.1.9 has no Linformer layer): export
+# refused.
+ATTN_KINDS = {'linformer': 'attn-linformer'}
+for _key in ('arch.attn_kind', 'arch.linformer_k'):
+    UNWIRED.pop(_key, None)
+_DEEPSETS_EXCLUSIVE += ('arch.attn_kind',)
+
+
+def _attn_kind(value, cfg):
+    if value not in ATTN_KINDS:
+        return f'must be one of {sorted(ATTN_KINDS)} (softmax attention is the default when absent)'
+    if lookup(cfg, 'arch.pair_bias'):
+        return 'not combined with arch.pair_bias (the pair bias adds to the (N, N) softmax scores)'
+    if (lookup(cfg, 'experiment.distillation') or {}).get('attention_coefficient'):
+        return 'attention-map KD compares (N, N) softmax maps; not defined for this attention'
+    if value == 'linformer' and lookup(cfg, 'arch.linformer_k') is None:
+        return 'linformer needs arch.linformer_k'
+
+
+def _linformer_k(value, cfg):
+    if lookup(cfg, 'arch.attn_kind') != 'linformer':
+        return 'read only with arch.attn_kind "linformer"'
+    if isinstance(value, bool) or not isinstance(value, int) or not 1 <= value <= lookup(cfg, 'arch.n_part', 0):
+        return 'must be an int in [1, arch.n_part]'
+
+
+register('arch.attn_kind', 'attn-linformer / attn-relu-over-n', _attn_kind)
+register('arch.linformer_k', 'attn-linformer', _linformer_k)
