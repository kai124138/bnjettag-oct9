diff --git a/code/bnhgq2/delta_keys.py b/code/bnhgq2/delta_keys.py
index ee9544c..4411ac8 100644
--- a/code/bnhgq2/delta_keys.py
+++ b/code/bnhgq2/delta_keys.py
@@ -685,3 +685,22 @@ def _derived(value, cfg):
 
 
 register('arch.derived_features', 'derived-input-features', _derived)
+
+# gated-key-mask (anchor tree only; M039, M076-M080): arch.mask_gated_keys true zeroes the
+# attention to padded / pT-gated key slots: qat.KeyPadMask derives key validity from the model
+# input (standardized pT != the standardized value of a raw-zero slot, computed from the cache's
+# train-split input_std with the cache's own float32 ops), and QSoftmax's native mask sets
+# exp = 0 on masked keys. Needs the runner's builder (run_engram.builder_for passes input_std).
+# A jet whose keys are all masked gets all-zero attention. Mask not billed in EBOPs; no HLS path.
+UNWIRED.pop('arch.mask_gated_keys', None)
+_DEEPSETS_EXCLUSIVE += ('arch.mask_gated_keys',)
+
+
+def _mask_keys(value, cfg):
+    if value is not True:
+        return 'must be true (absent = no mask)'
+    if lookup(cfg, 'arch.attn_kind') is not None:
+        return 'defined for softmax attention over the N keys only (not with arch.attn_kind)'
+
+
+register('arch.mask_gated_keys', 'gated-key-mask', _mask_keys)
diff --git a/code/bnhgq2/qat.py b/code/bnhgq2/qat.py
