         return {**super().get_config(), "axes": list(self.axes)}
 
 
+@keras.saving.register_keras_serializable(package="bnhgq2")
+class KeyPadMask(keras.layers.Layer):
+    """Delta (gated-key-mask): (B, 1, 1, T) float mask, 1 on real keys, 0 on padded / pT-gated
+    keys. Those slots are all-zero in raw space, so their standardized pT equals exactly
+    `pad_value` = apply_input_std(0) of the train-split stats (same float32 ops as the cache);
+    a real constituent has raw pT != 0. Parameter-free; not billed in EBOPs; no HLS path."""
+
+    def __init__(self, pt_index=0, pad_value=0.0, **kwargs):
+        super().__init__(**kwargs)
+        self.pt_index, self.pad_value = int(pt_index), float(pad_value)
+
+    def call(self, x):
+        valid = ops.cast(ops.not_equal(x[..., self.pt_index], self.pad_value), x.dtype)
+        return valid[:, None, None, :]
+
+    def get_config(self):
+        return {**super().get_config(), "pt_index": self.pt_index, "pad_value": self.pad_value}
+
+
