+class LatentEMA:
+    """Delta (latent-ema-eval): per-step EMA of the binary latent kernels. Evaluation and
+    the saved candidate use the EMA latents (re-binarized by the forward); training continues
+    on the live latents. The shadow is saved inside each checkpoint leaf (latent_ema.npz)."""
+
+    def __init__(self, model, decay, arrays=None):
+        self.decay = float(decay)
+        self.pairs = []
+        for ly in model.layers:
+            if isinstance(ly, (qat.BitQEinsumDense, qat.BitQDense)):
+                key = ly._kernel.path.replace('/', '__')
+                init = arrays[key] if arrays is not None else ly._kernel.numpy()
+                self.pairs.append((key, ly._kernel, tf.Variable(init, trainable=False)))
+        if arrays is not None:
+            assert set(arrays) == {key for key, _, _ in self.pairs}, 'EMA shadow does not match the model'
+        self._live = None
+
+    def update(self):
+        for _, variable, shadow in self.pairs:
+            shadow.assign(self.decay * shadow + (1. - self.decay) * variable)
+
+    def swap_in(self):
+        self._live = [variable.numpy() for _, variable, _ in self.pairs]
+        for _, variable, shadow in self.pairs:
+            variable.assign(shadow)
+
+    def swap_out(self):
+        for (_, variable, _), live in zip(self.pairs, self._live):
+            variable.assign(live)
+        self._live = None
+
+    def arrays(self):
+        return {key: shadow.numpy() for key, _, shadow in self.pairs}
+
+
+def make_epoch_step(model, optimizer, xt, yt, cfg, teacher_logits=None, teacher_model=None, input_std=None,
+                    latent_ema=None):
     x = tf.convert_to_tensor(xt, dtype=tf.float32)
