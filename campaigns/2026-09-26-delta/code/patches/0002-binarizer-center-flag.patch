Subject: [PATCH 02/24] binarizer-center-flag: quant.binary_center false =
 uncentered absmean (B02, M017)

---
 code/bnhgq2/binarize.py   | 10 +++---
 code/bnhgq2/delta_keys.py |  4 +++
 code/bnhgq2/qat.py        | 72 ++++++++++++++++++++++++++++++++-------
 code/convert_binary.py    |  4 ++-
 4 files changed, 73 insertions(+), 17 deletions(-)

diff --git a/code/bnhgq2/binarize.py b/code/bnhgq2/binarize.py
index f31bad7..6698911 100644
--- a/code/bnhgq2/binarize.py
+++ b/code/bnhgq2/binarize.py
@@ -34,10 +34,11 @@ SCORE_FOLD = ("_attn_Wq", "_attn_Wk")
 LN_KILLED = ("_attn_Wv",)
 
 
-def absmean_binarize(w: np.ndarray):
-    """Returns (q int8 in {−1,0,+1}, beta float, alpha float, n_zero int)."""
+def absmean_binarize(w: np.ndarray, center: bool = True):
+    """Returns (q int8 in {−1,0,+1}, beta float, alpha float, n_zero int).
+    center=False: uncentered absmean (Delta quant.binary_center false), alpha = 0."""
     w = np.asarray(w, dtype=np.float64)
-    alpha = w.mean()
+    alpha = w.mean() if center else 0.0
     wc = w - alpha
     beta = np.abs(wc).mean() + 1e-6
     q = np.sign(wc)
@@ -68,7 +69,8 @@ def binarize_checkpoint(layers: dict, norm: str = "subln") -> dict:
     `norm` = arch.norm of the graph the folds are for (fold_class is norm-aware)."""
     out, total_zeros = {}, 0
     for name, wb in layers.items():
-        q, beta, alpha, n_zero = absmean_binarize(wb["kernel"])
+        opts = wb.get("binary") or {}
+        q, beta, alpha, n_zero = absmean_binarize(wb["kernel"], center=opts.get("center", True))
         total_zeros += n_zero
         out[name] = {
             "q": q, "beta": beta, "alpha": alpha, "n_zero": n_zero,
diff --git a/code/bnhgq2/delta_keys.py b/code/bnhgq2/delta_keys.py
