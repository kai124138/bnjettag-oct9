+        return config
+
     def call(self, inputs, training=None):
         if self.enable_iq:
             inputs = self.iq(inputs, training=training)
-        x = ops.matmul(inputs, bitnet_binary_ste(self._kernel))
+        x = ops.matmul(inputs, _delta_binarize(self, self._kernel))
         if self.bias is not None:
             x = ops.add(x, self.qbias)
         if self.activation is not None:
@@ -105,7 +134,24 @@ class BitQDense(QDense):
 
     @property
     def qkernel(self):
-        return bitnet_binary_ste(self._kernel)
+        return _delta_binarize(self, self._kernel)
+
+
+def _delta_binarize(layer, w):
+    """Dispatch on the layer's opt-in Delta options; no options -> the bundle binarizer."""
+    opts = layer.binary
+    if not opts:
+        return bitnet_binary_ste(w)
+    return bitnet_binary_ste(w, center=opts.get("center", True))
+
+
+def delta_binary_options(cfg: dict, layer_name: str) -> dict:
+    """Per-layer binarizer options from Delta keys; {} unless a key is set."""
+    q = cfg["quant"]
+    opts = {}
+    if q.get("binary_center", True) is False:
+        opts["center"] = False
+    return opts
 
 
