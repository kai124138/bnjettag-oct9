+[Delta 0025] Roots from the environment as in the anchor bundle (BNJ_RUN_ROOT for runs/ and
+logs/, default the 2026-09-22 screen root; BNJ_CAMPAIGN_DIR for index.json and the packs file,
+default this directory). Pack entries may be run names (resolved against the unique index.json
+`name`) and a packs file may be a dict {"packs": [...], "run_root": ..., "data_root": ...,
+"pack_meta": [{"data_root": ...}, ...]} whose roots are exported to the children as
+BNJ_RUN_ROOT / BNJ_DATA_ROOT; see resolve_pack. A list of row-number lists and an unset
+environment behave exactly as before.
+"""
 import json
 import os
 from pathlib import Path
@@ -8,9 +17,49 @@ import sys
