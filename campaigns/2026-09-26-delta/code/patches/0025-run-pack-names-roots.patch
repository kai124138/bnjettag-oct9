 HERE = Path(__file__).resolve().parent
+ROOT = Path(os.environ.get('BNJ_RUN_ROOT', str(Path(os.environ.get('BNJ_DATA_ROOT', '/data/constituent-study-20260922')) / 'fp32')))  # = run_study.ROOT
+CAMPAIGN = Path(os.environ.get('BNJ_CAMPAIGN_DIR', str(HERE)))
+EXIT_BAD_PACK = 2
 children = []
 
 
+def resolve_pack(spec, rows, completion_index):
+    """(row indices, env) for this pod's pack; legacy list form or the dict form above. A
+    pack_meta value wins over the file-level one; an environment value that disagrees with the
+    packs file is refused, never overridden."""
+    if isinstance(spec, dict):
+        packs = spec['packs']
+        meta = (spec.get('pack_meta') or [{}] * len(packs))[completion_index]
+        if not spec.get('run_root'):     # runner and children must agree on runs/ and logs/
+            print('PACKS_RUN_ROOT_MISSING', flush=True)
+            raise SystemExit(EXIT_BAD_PACK)
+    else:
+        packs, meta, spec = spec, {}, {}
+    env = {}
+    for key, var in (('run_root', 'BNJ_RUN_ROOT'), ('data_root', 'BNJ_DATA_ROOT')):
+        value = meta.get(key, spec.get(key))
+        if value is None:
+            continue
+        if os.environ.get(var) not in (None, str(value)):
+            print('PACKS_ENV_CONFLICT', var, os.environ[var], 'packs file', value, flush=True)
+            raise SystemExit(EXIT_BAD_PACK)
+        env[var] = str(value)
+    names = [r.get('name') for r in rows]
+    by_name = {n: i for i, n in enumerate(names) if n}
+    indices = []
+    for item in packs[completion_index]:
+        if isinstance(item, str):
+            if names.count(item) != 1:
+                print('PACK_NAME_NOT_UNIQUE_IN_INDEX' if item in by_name else 'PACK_NAME_NOT_IN_INDEX', item, flush=True)
+                raise SystemExit(EXIT_BAD_PACK)
+            item = by_name[item]
+        elif isinstance(item, bool) or not isinstance(item, int):
+            print('PACK_ENTRY_INVALID', repr(item), flush=True)
+            raise SystemExit(EXIT_BAD_PACK)
+        indices.append(item)
+    return indices, env
+
+
 def stop(signum, frame):
     for child, *_ in children:
         if child.poll() is None:
