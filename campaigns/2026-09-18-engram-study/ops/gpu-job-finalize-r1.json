{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "name": "kai-engram-finalize-e100-a10364ed-r1",
    "namespace": "cms-ml",
    "labels": {
      "app": "kai-engram-finalize",
      "campaign": "engram-study-20260918"
    }
  },
  "spec": {
    "completionMode": "Indexed",
    "completions": 2,
    "parallelism": 2,
    "backoffLimitPerIndex": 0,
    "maxFailedIndexes": 2,
    "podReplacementPolicy": "Failed",
    "activeDeadlineSeconds": 7200,
    "ttlSecondsAfterFinished": 604800,
    "podFailurePolicy": {
      "rules": [
        {
          "action": "Ignore",
          "onPodConditions": [
            {
              "type": "DisruptionTarget"
            }
          ]
        }
      ]
    },
    "template": {
      "metadata": {
        "labels": {
          "app": "kai-engram-finalize",
          "campaign": "engram-study-20260918"
        }
      },
      "spec": {
        "affinity": {
          "nodeAffinity": {
            "requiredDuringSchedulingIgnoredDuringExecution": {
              "nodeSelectorTerms": [
                {
                  "matchExpressions": [
                    {
                      "key": "nvidia.com/gpu.product",
                      "operator": "In",
                      "values": [
                        "NVIDIA-L40"
                      ]
                    },
                    {
                      "key": "kubernetes.io/hostname",
                      "operator": "NotIn",
                      "values": [
                        "k8s-chase-ci-07.calit2.optiputer.net",
                        "nautilus-ext-gpu01.fullerton.edu",
                        "ren-gp-argo-01.madren.org"
                      ]
                    }
                  ]
                }
              ]
            }
          }
        },
        "automountServiceAccountToken": false,
        "containers": [
          {
            "args": [
              "set -euo pipefail\nexport NVIDIA_TF32_OVERRIDE=0  # finalize-only rerun: force FP32 math, see ops/README.md\nexport KERAS_BACKEND=tensorflow MPLBACKEND=Agg TF_FORCE_GPU_ALLOW_GROWTH=true\nexport OMP_NUM_THREADS=2 TF_NUM_INTRAOP_THREADS=2 TF_NUM_INTEROP_THREADS=1 OPENBLAS_NUM_THREADS=1\nmkdir -p /work/code\necho 'a10364eda9f4e5b8fbdfe1b4eadbae7b60006362bc9f493cafb056e74dedc792  /cmcode/hgq2.tar.gz' | sha256sum -c -\ntar -xzf /cmcode/hgq2.tar.gz -C /work/code --strip-components=1\nexport PYTHONPATH=/work/code BNHGQ2_CODE_SHA256=a10364eda9f4e5b8fbdfe1b4eadbae7b60006362bc9f493cafb056e74dedc792\n\nexport WANDB_ENTITY=kayamaguchi-uc-san-diego WANDB_PROJECT=BNJetTag-Engram-Experimental\nexport WANDB_GROUP=engram-screen WANDB_MODE=online WANDB_TAGS=engram,pilot,l1x3,n16,validation-only\nexport WANDB_DIR=/work WANDB_CACHE_DIR=/work/wandb-cache WANDB_DATA_DIR=/work/wandb-data\nexport WANDB_DISABLE_CODE=true WANDB_QUIET=true\npip install -q --no-cache-dir -r /work/code/requirements-training.txt\nNVLIBS=$(python -c \"import glob; print(':'.join(sorted(glob.glob('/usr/local/lib/python*/site-packages/nvidia/*/lib'))))\")\nexport LD_LIBRARY_PATH=\"$NVLIBS${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}\"\npython /work/code/ops/private_project.py\nnvidia-smi --query-gpu=name,memory.total --format=csv,noheader\npython -c \"import tensorflow as tf; assert tf.config.list_physical_devices('GPU'); print('GPU_GATE_PASS')\"\nARM=$(python -c \"import os; i=int(os.environ['JOB_COMPLETION_INDEX']); assert 0<=i<4; print(f'engram-e{i:02d}-s1')\")\ntimeout --signal=TERM --kill-after=180s 82800s python -u /work/code/run_engram.py train --config /work/code/configs/engram/$ARM.json --data-cache /data/batch20260917/n16/data --out /data/engram-study-20260918/runs/$ARM --stop-after 100 --track\n"
            ],
            "command": [
              "bash",
              "-c"
            ],
            "env": [
              {
                "name": "WANDB_API_KEY",
                "valueFrom": {
                  "secretKeyRef": {
                    "key": "WANDB_API_KEY",
                    "name": "kai-wandb"
                  }
                }
              }
            ],
            "image": "python:3.12",
            "imagePullPolicy": "IfNotPresent",
            "name": "train",
            "resources": {
              "limits": {
                "cpu": "4",
                "ephemeral-storage": "24Gi",
                "memory": "12Gi",
                "nvidia.com/gpu": "1"
              },
              "requests": {
                "cpu": "4",
                "ephemeral-storage": "24Gi",
                "memory": "12Gi",
                "nvidia.com/gpu": "1"
              }
            },
            "terminationMessagePath": "/dev/termination-log",
            "terminationMessagePolicy": "File",
            "volumeMounts": [
              {
                "mountPath": "/cmcode",
                "name": "code",
                "readOnly": true
              },
              {
                "mountPath": "/work",
                "name": "work"
              },
              {
                "mountPath": "/data",
                "name": "persistent"
              }
            ]
          }
        ],
        "dnsPolicy": "ClusterFirst",
        "nodeSelector": {
          "kubernetes.io/arch": "amd64"
        },
        "restartPolicy": "Never",
        "schedulerName": "default-scheduler",
        "securityContext": {},
        "terminationGracePeriodSeconds": 180,
        "volumes": [
          {
            "name": "code",
            "configMap": {
              "name": "kai-engram-code-a10364eda9",
              "defaultMode": 420
            }
          },
          {
            "emptyDir": {
              "sizeLimit": "24Gi"
            },
            "name": "work"
          },
          {
            "name": "persistent",
            "persistentVolumeClaim": {
              "claimName": "kai-data"
            }
          }
        ]
      }
    }
  }
}