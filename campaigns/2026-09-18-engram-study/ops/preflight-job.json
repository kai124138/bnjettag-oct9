{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "name": "kai-engram-preflight-a10364ed",
    "namespace": "cms-ml",
    "labels": {
      "app": "kai-engram-preflight"
    }
  },
  "spec": {
    "ttlSecondsAfterFinished": 604800,
    "template": {
      "metadata": {
        "labels": {
          "app": "kai-engram-preflight"
        }
      },
      "spec": {
        "affinity": {
          "nodeAffinity": {
            "requiredDuringSchedulingIgnoredDuringExecution": {
              "nodeSelectorTerms": [
                {
                  "matchExpressions": [
                    {
                      "key": "kubernetes.io/hostname",
                      "operator": "NotIn",
                      "values": [
                        "nautilus-ext-gpu01.fullerton.edu",
                        "k8s-chase-ci-07.calit2.optiputer.net"
                      ]
                    }
                  ]
                }
              ]
            }
          }
        },
        "automountServiceAccountToken": false,
        "containers": [
          {
            "args": [
              "set -euo pipefail\nexport KERAS_BACKEND=tensorflow MPLBACKEND=Agg TF_FORCE_GPU_ALLOW_GROWTH=true\nexport OMP_NUM_THREADS=2 TF_NUM_INTRAOP_THREADS=2 TF_NUM_INTEROP_THREADS=1 OPENBLAS_NUM_THREADS=1\nmkdir -p /work/code\necho 'a10364eda9f4e5b8fbdfe1b4eadbae7b60006362bc9f493cafb056e74dedc792  /cmcode/hgq2.tar.gz' | sha256sum -c -\ntar -xzf /cmcode/hgq2.tar.gz -C /work/code --strip-components=1\nexport PYTHONPATH=/work/code BNHGQ2_CODE_SHA256=a10364eda9f4e5b8fbdfe1b4eadbae7b60006362bc9f493cafb056e74dedc792\n\nexport CUDA_VISIBLE_DEVICES=-1 WANDB_MODE=disabled TF_CPP_MIN_LOG_LEVEL=2\npip install -q --no-cache-dir -r /work/code/requirements-cpu.txt\npython -u /work/code/run_engram.py preflight --out /data/engram-study-20260918/preflight/synthetic-a10364ed\npython -u /work/code/ops/preflight_production.py\n"
            ],
            "command": [
              "bash",
              "-c"
            ],
            "image": "python:3.12",
            "imagePullPolicy": "IfNotPresent",
            "name": "preflight",
            "resources": {
              "requests": {
                "cpu": "2",
                "memory": "8Gi",
                "ephemeral-storage": "8Gi"
              },
              "limits": {
                "cpu": "2",
                "memory": "8Gi",
                "ephemeral-storage": "8Gi"
              }
            },
            "terminationMessagePath": "/dev/termination-log",
            "terminationMessagePolicy": "File",
            "volumeMounts": [
              {
                "mountPath": "/cmcode",
                "name": "code",
                "readOnly": true
              },
              {
                "mountPath": "/work",
                "name": "work"
              },
              {
                "mountPath": "/data",
                "name": "persistent"
              }
            ]
          }
        ],
        "dnsPolicy": "ClusterFirst",
        "nodeSelector": {
          "kubernetes.io/arch": "amd64"
        },
        "restartPolicy": "Never",
        "schedulerName": "default-scheduler",
        "securityContext": {},
        "terminationGracePeriodSeconds": 180,
        "volumes": [
          {
            "name": "code",
            "configMap": {
              "name": "kai-engram-code-a10364eda9",
              "defaultMode": 420
            }
          },
          {
            "emptyDir": {
              "sizeLimit": "24Gi"
            },
            "name": "work"
          },
          {
            "name": "persistent",
            "persistentVolumeClaim": {
              "claimName": "kai-data"
            }
          }
        ]
      }
    },
    "backoffLimit": 0,
    "activeDeadlineSeconds": 3600
  }
}
