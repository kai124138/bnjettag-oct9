+def test_pid_telemetry_file_matches_history_and_resume(tmp_path):
+    """Amendment patch 0033 (CPU suite job; runs run_training on the tiny synthetic fixture):
+    pid_telemetry.jsonl has one row per epoch, agrees with the history, survives a resume at an
+    untraced pause unchanged, and passes the chang1002c monitor's controller audit."""
+    import importlib.util
+    from pathlib import Path
+    from bnhgq2 import ablation
+    cfg = option_c()
+    (xt, yt, xv, yv), info = arrays()
+    ablation.run_training(cfg, (xt, yt, xv, yv), info, tmp_path / 'straight')
+    ablation.run_training(cfg, (xt, yt, xv, yv), info, tmp_path / 'paused', stop_after=4)
+    ablation.run_training(cfg, (xt, yt, xv, yv), info, tmp_path / 'paused')
+
+    def telemetry(out):
+        return [json.loads(x) for x in (out / ablation.PID_TELEMETRY).read_text().splitlines()]
+    straight, paused = telemetry(tmp_path / 'straight'), telemetry(tmp_path / 'paused')
+    recs = records(tmp_path / 'straight')
+    assert [t['epoch'] for t in straight] == list(range(len(recs)))
+    for t, r in zip(straight, recs):
+        assert t['pid_stepped'] == r['pid_stepped'] and t['pid_step_span'] == r['pid_step_span']
+        assert t['beta_end'] == r['beta'] and t['pid_integral'] == r['pid_integral']
+        assert t['ebops_traced'] == (r['ebops'] if r['ebops_traced'] else None)
+        assert t['ebops_in_training'] == r['ebops_in_training']
+    drop = ('learning_rate',)
+    assert [{k: v for k, v in t.items() if k not in drop} for t in straight] == \
+           [{k: v for k, v in t.items() if k not in drop} for t in paused]
+    spec = importlib.util.spec_from_file_location(
+        'monitor_c', Path(__file__).resolve().parents[1] / 'campaigns' / 'chang1002c' / 'monitor_c.py')
+    monitor = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(monitor)
+    assert monitor.audit(cfg, straight) == []
