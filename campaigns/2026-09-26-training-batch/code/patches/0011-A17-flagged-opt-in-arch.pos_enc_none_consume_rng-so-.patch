 campaigns/chang0926/generate.py                  |  2 +-
 campaigns/chang0926/index.json                   | 16 ++++++++--------
 11 files changed, 22 insertions(+), 9 deletions(-)

diff --git a/bnhgq2/qat.py b/bnhgq2/qat.py
index 084e532..f7d1e92 100644
--- a/bnhgq2/qat.py
+++ b/bnhgq2/qat.py
@@ -528,6 +528,11 @@ def build_qat_model(cfg: dict, seed: int, enable_ebops: bool = True,
         h = dense_einsum("input_proj", "btf,fd->btd", (T, D), h, bias_axes="td")
         if with_pos_enc and A["pos_enc"] == "learned":
             h = AddPositional(name="pos_enc")(h)
+        elif A["pos_enc"] == "none" and A.get("pos_enc_none_consume_rng", False):
+            # [A17] opt-in: draw (and discard) the glorot_uniform values the learned table
+            # would have taken, so every later initializer draw -- and hence every kernel --
+            # equals the learned-PE build at the same seed. No layer, no weight, no cost.
+            keras.initializers.GlorotUniform()(shape=(1, T, D))
 
         # ---- pairwise-invariant attention-logit bias (shared across blocks) ----
         pair_bias_tensor = None
