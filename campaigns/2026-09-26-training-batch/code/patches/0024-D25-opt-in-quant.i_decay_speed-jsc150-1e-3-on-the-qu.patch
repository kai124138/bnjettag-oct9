diff --git a/bnhgq2/qat.py b/bnhgq2/qat.py
index f7d1e92..68a883f 100644
--- a/bnhgq2/qat.py
+++ b/bnhgq2/qat.py
@@ -417,6 +417,19 @@ def build_qat_model(cfg: dict, seed: int, enable_ebops: bool = True,
     if (act_overflow != "SAT" or softmax_quant != "fixed") and (act_calib != "free" or not binv):
         raise ValueError(f"{cfg['name']}: act_overflow/softmax_quant need binary weights "
                          "and act_calib='free'")
+    # [D25] (2026-09-27, opt-in): quant.i_decay_speed sets HGQ2's per-step decay of a WRAP
+    # quantizer's integer bits (i <- max(i - i_decay_speed, i_batch) in training) on exactly
+    # the quantizers ablation.i_decay_speeds() records. Absent => nothing below runs and the
+    # HGQ2 default (0.01) stays, byte-identical to the build without this key.
+    i_decay_speed = cfg["quant"].get("i_decay_speed")
+    if i_decay_speed is not None:
+        if isinstance(i_decay_speed, bool) or not isinstance(i_decay_speed, (int, float)) \
+                or not np.isfinite(i_decay_speed) or i_decay_speed <= 0:
+            raise ValueError(f"{cfg['name']}: quant.i_decay_speed must be a finite float > 0, "
+                             f"got {i_decay_speed!r}")
+        if act_overflow != "WRAP":
+            raise ValueError(f"{cfg['name']}: quant.i_decay_speed needs quant.act_overflow='WRAP' "
+                             "(only WRAP quantizers carry i_decay_speed)")
     taps: dict = {}
 
     # Norm placement: 'subln' (default -> PSubLN, existing behavior) | 'none' (identity
@@ -600,9 +613,27 @@ def build_qat_model(cfg: dict, seed: int, enable_ebops: bool = True,
         out = dense("head_fc2", C, h, use_bias=True)
 
         model = keras.Model(x_in, out, name=cfg["name"])
+    if i_decay_speed is not None:
+        set_i_decay_speed(model, float(i_decay_speed))
     return model, taps
 
 
+def set_i_decay_speed(model, value: float) -> int:
+    """[D25] assign `value` to `_i_decay_speed` of every quantizer that
+    ablation.i_decay_speeds() enumerates (activation_quantizers with `_i_decay_speed`).
+    The variable exists already (HGQ2 creates it in build() for WRAP), so no new weights and
+    no RNG draw. Returns the number assigned; raises if none."""
+    from .ebops_target import activation_quantizers
+    n = 0
+    for _, q in activation_quantizers(model):
+        if hasattr(q, "_i_decay_speed"):
+            q._i_decay_speed.assign(value)
+            n += 1
+    if n == 0:
+        raise ValueError(f"{model.name}: quant.i_decay_speed set but no quantizer carries it")
+    return n
+
+
 # --------------------------------------------------------------------------- #
 # (f) activation calibration (warmup-calibrated-then-frozen static grids)      #
 # --------------------------------------------------------------------------- #
