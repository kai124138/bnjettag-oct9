diff --git a/bnhgq2/wandb_util.py b/bnhgq2/wandb_util.py
index 89a9196..456ca9e 100644
--- a/bnhgq2/wandb_util.py
+++ b/bnhgq2/wandb_util.py
@@ -55,6 +55,37 @@ def init_kwargs(*, name: str, job_type: str, config: dict | None = None,
     return kw
 
 
+# Run stage (PREFLIGHT gate v1, 2026-09-27). The same config names run first in the
+# pilot/canary pod and later in production, so a W&B run id taken from the config name alone
+# makes a production run append to the pilot's run (resume='allow'). BNJ_STAGE (set by the Job
+# manifest, never by a config, so config_sha256 is unchanged) keys the id and the group.
+STAGE_GROUP_SUFFIX = {"canary": "-canary", "pilot": "-canary", "production": ""}
+
+
+def run_stage(required: bool = False) -> str | None:
+    stage = os.environ.get("BNJ_STAGE", "").strip() or None
+    if stage is None and required:
+        raise RuntimeError("BNJ_STAGE must be set (canary, pilot or production) for a tracked run")
+    if stage is not None and stage not in STAGE_GROUP_SUFFIX:
+        raise ValueError(f"BNJ_STAGE={stage!r}; expected one of {sorted(STAGE_GROUP_SUFFIX)}")
+    return stage
+
+
+def stage_run_id(name: str, stage: str | None) -> str:
+    """Deterministic within a stage (a relaunched arm resumes its own run), distinct across
+    stages. stage None: the historical id sha256(name)[:12] (screen runners, no BNJ_STAGE)."""
+    key = name if stage is None else f"{stage}\0{name}"
+    return hashlib.sha256(key.encode()).hexdigest()[:12]
+
+
+def stage_group(group: str | None, stage: str | None) -> str | None:
+    """pilot/canary: '<config group>-canary' (STUDY: canary group chang-n64-20260926-canary;
+    wave 2: chang-n64-20260926-wave2-canary); production or no stage: the config group."""
+    if not group or stage is None:
+        return group
+    return group + STAGE_GROUP_SUFFIX[stage]
+
+
 def sha256(path: str) -> str:
     h = hashlib.sha256()
     with open(path, "rb") as f:
