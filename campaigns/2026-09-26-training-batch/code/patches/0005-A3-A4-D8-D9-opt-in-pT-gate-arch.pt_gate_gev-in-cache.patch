+def apply_pt_gate(X, features, pt_gate_gev, stats=None):
+    """[A3]/[D7] jsc150 data.py:22-26, `X *= X[..., :1] >= 2`: zero every feature of a
+    constituent whose RAW pT (GeV, the exact `_pt` column, not `_ptrel`) is below the
+    threshold. Runs after the pT sort, top-N truncation and feature subset, before
+    standardization. `pt_gate_gev=None` returns X unchanged (the historical pipeline).
+    `stats` (dict) collects counts for data_info.json; it never changes the output."""
+    if pt_gate_gev is None:
+        return X
+    features = list(features)
+    if 'pt' not in features:
+        raise ValueError('pT gate needs the raw `pt` feature in arch.features')
+    pt = X[..., features.index('pt')]
+    keep = pt >= float(pt_gate_gev)
+    if stats is not None:
+        nonzero = pt != 0
+        stats.update(pt_gate_gev=float(pt_gate_gev), n_slots=int(pt.size),
+                     n_padded_slots=int((~nonzero).sum()),
+                     n_newly_gated_slots=int((nonzero & ~keep).sum()),
+                     n_jets_with_newly_gated=int((nonzero & ~keep).any(axis=-1).sum()),
+                     n_jets_all_gated=int((~keep).all(axis=-1).sum()),
+                     pt_nonzero_min=float(pt[nonzero].min()) if nonzero.any() else None,
+                     pt_max=float(pt.max()), n_negative_pt=int((pt < 0).sum()))
+    return (X * keep[..., None]).astype(X.dtype, copy=False)
+
+
+def load_eval_set(data_dir: str, n_part: int = 10, features=None, pt_gate_gev=None,
+                  gate_stats=None):
     """features=None keeps all 16 columns (byte-identical pre-pre-conference behaviour);
     a list of suffixes selects columns AFTER the pT sort and top-N truncation, so
-    the particle ordering is identical regardless of the feature subset."""
+    the particle ordering is identical regardless of the feature subset.
+    pt_gate_gev (default None = no gate) applies `apply_pt_gate` after the subset, exactly
+    as the training cache does; labels and row order are unchanged by the gate."""
     files = sorted(glob.glob(os.path.join(data_dir, "*.h5")))
     if not files:
         raise FileNotFoundError(f"no .h5 files in {data_dir}")
