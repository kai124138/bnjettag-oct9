+# --------------------------------------------------------------------------- #
+# (d') H3 attention bit floor (opt-in quant.attn_bit_floor; pilot program)     #
+# --------------------------------------------------------------------------- #
+# jsc150 keeps attention widths >= 1 bit with a constraint on the bit-count variable of a KBI
+# quantizer (bc=Min(1) on the Linformer attention tables, get_llformer; bc=Min(4) on xfm's
+# tables; a commented datalane kbi bc=Min(1) scope before xfm's MHA). Our Q/K/V quantizers are
+# KIF WRAP: i is tracked from the data and only f is trained, so no single-variable constraint
+# can bound bits = relu(i + f). FlooredKIF gives the same guarantee without changing the
+# parametrisation: the effective f is max(f, m - i - k*[SAT]), so HGQ2 `bits` (what EBOPs price
+# and what the forward pass uses) never drops below m, and the raw f is clamped to that bound at
+# every training forward so it cannot drift below it (no hysteresis once pressure relaxes). A
+# quantizer above the floor behaves exactly as the unfloored KIF quantizer.
+ATTN_FLOOR_SITES = ("q", "k", "v", "softmax_in", "softmax_out")
+
+
+class FlooredKIF(_HGQ_KIF):
+    """HGQ2 KIF quantizer with HGQ2 `bits` >= min_bits (see the block comment above)."""
+
+    def __init__(self, min_bits, **kwargs):
+        super().__init__(**kwargs)
+        self.min_bits = float(min_bits)
+
+    def f_floor(self):
+        k = self.k if self.overflow_mode == "SAT" else 0.0   # SAT bits = relu(i+f) + k
+        i = self.i
+        # trace_minmax(reset=True) parks i at -1e9 until the first traced batch sets it; no
+        # range yet means no floor (else f -> +1e9 and the rounding overflows to NaN)
+        return ops.where(i > -1e6, self.min_bits - k - i, ops.full_like(i, -1e9))
+
+    @property
+    def f(self):
+        return ops.maximum(_round_conv(ops.cast(self._f, self._f.dtype)), self.f_floor())
+
+    def call(self, inputs, training=None):
+        if training is True and self.trainable:
+            self._f.assign(ops.maximum(self._f, ops.cast(self.f_floor(), self._f.dtype)))
+        return super().call(inputs, training=training)
+
+
+@keras.saving.register_keras_serializable(package="bnhgq2")
+class FlooredKIFConfig(QuantizerConfig):
+    """A KIF QuantizerConfig whose quantizer holds HGQ2 `bits` >= min_bits (H3). Serialised with
+    its floor, so a reloaded `.keras` file keeps it."""
+
+    def __init__(self, q_type="kif", place="datalane", min_bits=1, **kwargs):
+        super().__init__(q_type, place, **kwargs)
+        assert self.q_type == "kif", "the attention bit floor is defined for KIF quantizers"
+        self.min_bits = int(min_bits)
+
+    def get_config(self):
+        return {**super().get_config(), "min_bits": self.min_bits}
+
+    def get_quantizer(self):
+        return FlooredKIF(min_bits=self.min_bits, **self)
+
+
+def _with_bit_floor(conf: QuantizerConfig, min_bits: int) -> FlooredKIFConfig:
+    """The same quantizer config as `conf`, with a bit floor."""
+    c = conf.get_config()
+    q_type, place = c.pop("q_type"), c.pop("place")
+    return FlooredKIFConfig(q_type, place, min_bits=min_bits, **c)
+
+
+def attn_bit_floor(cfg: dict):
+    """Validated quant.attn_bit_floor -> (bits, frozenset(sites)), or None when absent."""
+    spec = cfg["quant"].get("attn_bit_floor")
+    if spec is None:
+        return None
+    name = cfg.get("name", "?")
+    if not isinstance(spec, dict) or set(spec) != {"bits", "sites"}:
+        raise ValueError(f"{name}: quant.attn_bit_floor must be {{'bits': 1|2, 'sites': [...]}}, got {spec!r}")
+    bits, sites = spec["bits"], spec["sites"]
+    if isinstance(bits, bool) or bits not in (1, 2):
+        raise ValueError(f"{name}: quant.attn_bit_floor.bits must be 1 or 2, got {bits!r}")
+    if not isinstance(sites, list) or not sites or len(set(sites)) != len(sites) \
+            or not set(sites) <= set(ATTN_FLOOR_SITES):
+        raise ValueError(f"{name}: quant.attn_bit_floor.sites must be a non-empty list of distinct "
+                         f"{ATTN_FLOOR_SITES}, got {sites!r}")
+    q = cfg["quant"]
+    if str(q.get("act_calib", "frozen")).lower() != "free" or q["weight"] == "none":
+        raise ValueError(f"{name}: quant.attn_bit_floor needs learned activation widths (act_calib 'free')")
+    if {"softmax_in", "softmax_out"} & set(sites) and str(q.get("softmax_quant", "fixed")).lower() != "chang":
+        raise ValueError(f"{name}: softmax floor sites need quant.softmax_quant 'chang' (learned softmax widths)")
+    return int(bits), frozenset(sites)
+
