+def kbi_weight_layers(model):
+    """[D22] {layer_name: layer} of every layer whose kernel quantizer is a trainable HGQ2 kbi
+    weight quantizer (arm NB). Empty for every other weight type."""
+    from hgq.quantizer.internal import FixedPointQuantizerKBI
+    out = {}
+    for ly in model.layers:
+        if isinstance(ly, (BitQEinsumDense, BitQDense)):
+            continue
+        kq = getattr(ly, "kq", None)
+        qz = getattr(kq, "quantizer", None)
+        if isinstance(qz, FixedPointQuantizerKBI) and qz.trainable and getattr(qz, "_is_weight", False):
+            out[ly.name] = ly
+    return out
+
+
+def weight_width_record(model):
+    """[D22] per-layer weight-width distribution of arm NB (the STUDY's replacement for the binary
+    gate): HGQ2 `bits` per weight (= b under SAT_SYM), fraction at 0 bits, mean bits, and the
+    number of distinct effective (inference) kernel values."""
+    out = {}
+    for name, ly in kbi_weight_layers(model).items():
+        bits = np.asarray(ops.convert_to_numpy(ly.kq.quantizer.bits), dtype=float).ravel()
+        values = np.asarray(ops.convert_to_numpy(ly.kq(ly._kernel, training=False))).ravel()
+        out[name] = {"n": int(bits.size), "zero_bits_fraction": float(np.mean(bits == 0)),
+                     "mean_bits": float(bits.mean()), "max_bits": float(bits.max()),
+                     "distinct_values": int(np.unique(np.round(values, 10)).size)}
+    return out
+
+
+def on_static_int8_grid(values, i0: int = 2) -> bool:
+    """True if every value lies on the static int8 weight grid `_static_w8(i0)` builds
+    (fixed<8, 1+i0>: step 2^-(7-i0), range [-2^i0, 2^i0 - step]). [A22]: no NB kernel may."""
+    v = np.asarray(values, dtype=np.float64).ravel()
+    step = 2.0 ** -(7 - int(i0))
+    on_step = np.allclose(v / step, np.round(v / step), atol=1e-6)
+    return bool(on_step and v.min() >= -(2.0 ** i0) and v.max() <= 2.0 ** i0 - step)
+
+
 def effective_weight_values(model):
     """Return {layer_name: sorted unique effective forward weight values} for every
     binary layer — the binary gate (must be exactly two values, symmetric, no zero)."""
