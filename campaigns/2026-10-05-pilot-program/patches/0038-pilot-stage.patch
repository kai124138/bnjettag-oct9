 # regime-A pilot, so it gets its own id key and its own group (not -canary, whose runs are
 # pulled by name).
 # pilot-c (option-(c) amendment, 2026-10-02): the replacement traced-only-PID pilot.
+# pilot-r1/r2/r3 (pilot program, 2026-10-05, campaigns/2026-10-05-pilot-program): one stage per
+# round, so a config name re-run in a later round gets its own run id and group.
 STAGE_GROUP_SUFFIX = {"canary": "-canary", "pilot": "-canary", "pilot-b": "-pilot-b", "pilot-c": "-pilot-c",
+                      "pilot-r1": "-pilot-r1", "pilot-r2": "-pilot-r2", "pilot-r3": "-pilot-r3",
                       "production": ""}
 
 
 def run_stage(required: bool = False) -> str | None:
     stage = os.environ.get("BNJ_STAGE", "").strip() or None
     if stage is None and required:
-        raise RuntimeError("BNJ_STAGE must be set (canary, pilot, pilot-b, pilot-c or production) for a tracked run")
