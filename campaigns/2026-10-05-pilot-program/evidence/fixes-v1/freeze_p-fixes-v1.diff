+        'pod_exit() { rc=$?; trap - EXIT; el=$(( $(date +%s) - T0 )); '
+        f'if [ "$rc" = 0 ] || [ "$rc" = {H.EXIT_EPOCH0_ALL_DIVERGED} ]; then exit "$rc"; fi; '
+        'if [ -n "$ARM_FINAL_RC" ]; then echo "POD_EXIT_FINAL rc=$rc exit=$ARM_FINAL_RC elapsed_s=$el"; exit "$ARM_FINAL_RC"; fi; '
