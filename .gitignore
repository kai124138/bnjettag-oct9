# Repo root since 2026-07-05 (was qkeras-bitnet-run-2026-06-22/, itself renamed to
# bnjettag/ later the same day once the dated name had calcified into the permanent
# working tree; models/ was folded into bnjettag/models/ in that same rename).
# Personal learning notes (moved into _attic/learning-vault/ on 2026-08-13).
LEARN/
.vibe-wise/
.obsidian/
_attic/learning-vault/

# Secrets — never commit
**/wandb-api-key.txt
*.env

# Heavy / generated artifacts (noise for agents too)
.venv-plots/
.venv-hgq2/
session-export-*/
*-local-command-caveat*.txt
# local W&B run dirs, wherever they appear (never build inputs)
wandb/
!bnjettag/code/hgq2/bnhgq2/wandb_util.py
*.zip
__pycache__/
.DS_Store

# Large binaries — fetch from W&B (models) / Zenodo (data); docs stay tracked
# (anchored to repo root: other tracked subdirs must not match)
/bnjettag/models/*
!/bnjettag/models/MODEL.md
/data/

# Third-party clones and heavy superseded material. Everything pre-Round-14 moved to
# _attic/ on 2026-08-13 (see _attic/README.md); the manifest and restore script stay
# tracked so the move is reversible, the bulk clones and legacy archive do not.
/reference-code/
/archive/
/_attic/legacy-archive/
/_attic/pre-r14/models/

# Downloaded third-party paper PDFs (notes + INDEX + fetch script stay tracked)
docs/literature/**/*.pdf

# Claude Code local settings (machine-specific); agents/, commands/, memory/ stay shareable
.claude/settings.local.json

# Obsidian mirror of the assistant sessions, written by ~/.claude/hooks/claude_to_obsidian.py
# (the vault itself, .obsidian/, is ignored further up). Agent context, not the record.
/Sessions/

