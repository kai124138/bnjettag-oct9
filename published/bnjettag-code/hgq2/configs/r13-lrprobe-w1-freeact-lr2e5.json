{
  "name": "r13-lrprobe-w1-freeact-lr2e5",
  "era": 2,
  "arch": {
    "n_part": 10,
    "n_feat": 16,
    "d_model": 32,
    "n_heads": 4,
    "n_layers": 2,
    "ffn_dim": 64,
    "n_classes": 5,
    "pool": "gap",
    "ffn_act": "relu",
    "norm": "none",
    "norm_placement": "per_linear",
    "pos_enc": "learned",
    "softmax_free": false,
    "input_std": true
  },
  "quant": {
    "weight": "binary_absmean",
    "act_bits": 8,
    "act_policy": "static_per_tensor_mse_calibrated",
    "calib_n": 8192,
    "act_calib": "free",
    "beta0": 0.0,
    "act_bw_l1": 1e-08
  },
  "train": {
    "data": "/data/hls4ml_lhc_jet/train/train",
    "validation_split": 0.2,
    "epochs": 300,
    "batch": 1024,
    "lr": 2e-05,
    "lr_schedule": "cosine_restarts",
    "lr_cycle_epochs": 500,
    "lr_min_frac": 0.02,
    "warmup_epochs": 5,
    "decay_epochs": 0,
    "decay_power": 1.0,
    "beta2": 0.98,
    "weight_decay": 0.01,
    "clip_mode": "value",
    "clipvalue": 1.0,
    "clipnorm": 1.0,
    "es_patience": 0,
    "val_batch": 4096,
    "wandb_project": "bnjettag-final",
    "ebops": {
      "enable": true,
      "beta_schedule": null,
      "threshold": 500000.0,
      "front_dir": "front",
      "metrics": [
        "val_macro_auc",
        "ebops"
      ],
      "sides": [
        1,
        -1
      ]
    }
  },
  "hls": {
    "backend": "Vitis",
    "part": "xcvu13p-flga2577-2-e",
    "clock_ns": 2.5,
    "rf": 256,
    "io": "io_parallel"
  }
}
